# Copy this file to .env (in this backend/ folder) and fill in real values.
# .env is gitignored on purpose (it holds real secrets) — every teammate
# needs their own local copy. Ask whoever owns the Supabase project / Groq
# account for these values; do not share them over git, commit them, or
# paste them in chat/issues.

GROQ_API_KEY=
# Dedicated keys for agent3 (resume polish) and agent7 (legal drafting) so
# their heavier usage doesn't share rate limits with agents 1/2/4/5/6.
# Optional — falls back to GROQ_API_KEY if unset.
GROQ_API_KEY_AGENT3=
GROQ_API_KEY_AGENT7=
GROQ_MODEL=openai/gpt-oss-120b

# Same Supabase project used by frontend/ and messaging/, used server-side
# for auth token verification and (if DATABASE_URL is also set) durable
# profile storage.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional — only needed for scripts/admin tasks that must bypass RLS.
# Never expose this to a browser/frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Optional — a real Postgres connection string enables durable founder/
# investor profile storage across backend restarts. Without it the backend
# still runs fine; it just falls back to sessions_db.json as a local cache.
# Note: this does NOT cover the generated resume .docx file or its file
# path — those still live on local disk (static/resumes/, sessions_db.json)
# and are wiped on every redeploy, even with DATABASE_URL set.
# /api/resume/{owner_user_id} regenerates the file on demand from the
# durable profile when this happens, so it self-heals rather than 404ing.
DATABASE_URL=

# Optional — only needed if testing the LinkedIn "Sign in with LinkedIn" flow.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
# Fallback redirect target for the LinkedIn OAuth callback — only used if
# the Origin/Referer captured when the flow started isn't a trusted origin
# (see _trusted_frontend_origin in main_app.py). Should be your deployed
# frontend's URL in production, e.g. https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000

# Comma-separated list of frontend origins allowed to call the backend.
# Defaults to the standard local dev ports if unset.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174
